# Copy this file to .env and replace every value. .env is ignored by git, so
# your real values never reach GitHub. Use long random strings, for example
# from: python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=replace-me
ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me

# Login for the local S3 stand-in (SeaweedFS). Not an AWS key.
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
